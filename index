<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Amos Maina Muthee — Full-Stack Developer & Automation Specialist</title>
<meta name="description" content="Portfolio of Amos Maina Muthee, Full-Stack Web Developer and Business Automation Specialist based in Nairobi, Kenya." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0B0E14;
    --surface:#12161F;
    --surface-alt:#171C27;
    --border:#242B39;
    --text:#E7E9EE;
    --text-muted:#8B94A7;
    --text-faint:#5B6478;
    --amber:#E3A438;
    --amber-dim:#8A6A2E;
    --teal:#3FB6A8;
    --teal-dim:#245E58;
    --max:1120px;
    --radius:6px;
    --font-display:'Space Grotesk', sans-serif;
    --font-body:'IBM Plex Sans', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  a{color:inherit;}
  img{max-width:100%; display:block;}

  .wrap{
    max-width:var(--max);
    margin:0 auto;
    padding:0 28px;
  }

  /* ---------- NAV ---------- */
  header.site-nav{
    position:sticky; top:0; z-index:50;
    background:rgba(11,14,20,0.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 28px;
    max-width:var(--max); margin:0 auto;
  }
  .nav-mark{
    font-family:var(--font-display);
    font-weight:600;
    font-size:1.05rem;
    letter-spacing:0.01em;
    color:var(--text);
    text-decoration:none;
  }
  .nav-mark span{color:var(--amber);}
  .nav-links{
    display:flex; gap:28px; list-style:none; margin:0; padding:0;
  }
  .nav-links a{
    text-decoration:none;
    color:var(--text-muted);
    font-size:0.92rem;
    transition:color 0.15s ease;
  }
  .nav-links a:hover, .nav-links a:focus-visible{color:var(--amber);}
  .nav-toggle{display:none; background:none; border:1px solid var(--border); color:var(--text); border-radius:4px; padding:6px 10px; font-size:1.1rem;}

  @media (max-width:760px){
    .nav-links{
      position:fixed; top:60px; left:0; right:0;
      background:var(--surface);
      border-bottom:1px solid var(--border);
      flex-direction:column; gap:0;
      max-height:0; overflow:hidden;
      transition:max-height 0.25s ease;
    }
    .nav-links.open{max-height:400px;}
    .nav-links li{border-top:1px solid var(--border);}
    .nav-links a{display:block; padding:14px 28px;}
    .nav-toggle{display:block;}
  }

  a:focus-visible, button:focus-visible{
    outline:2px solid var(--amber);
    outline-offset:2px;
  }

  /* ---------- HERO ---------- */
  .hero{
    padding:76px 0 64px;
    border-bottom:1px solid var(--border);
  }
  .hero-grid{
    display:grid;
    grid-template-columns:1.15fr 0.85fr;
    gap:56px;
    align-items:center;
  }
  .hero-tag{
    font-family:var(--font-mono);
    font-size:0.8rem;
    color:var(--teal);
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-bottom:18px;
  }
  .hero-tag::before{
    content:'';
    width:7px; height:7px; border-radius:50%;
    background:var(--teal);
    box-shadow:0 0 0 3px var(--teal-dim);
  }
  h1.hero-name{
    font-family:var(--font-display);
    font-weight:700;
    font-size:clamp(2.1rem, 4.4vw, 3.3rem);
    line-height:1.08;
    margin:0 0 14px;
    letter-spacing:-0.01em;
  }
  .hero-role{
    font-size:1.15rem;
    color:var(--text-muted);
    margin:0 0 22px;
    max-width:46ch;
  }
  .hero-desc{
    color:var(--text-muted);
    max-width:56ch;
    margin:0 0 30px;
    font-size:0.99rem;
  }
  .hero-cta{
    display:flex; gap:14px; flex-wrap:wrap;
    margin-bottom:34px;
  }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 22px;
    border-radius:var(--radius);
    text-decoration:none;
    font-size:0.92rem;
    font-weight:500;
    transition:transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    border:1px solid transparent;
  }
  .btn-primary{
    background:var(--amber);
    color:#161200;
  }
  .btn-primary:hover{background:#f0b452;}
  .btn-ghost{
    border-color:var(--border);
    color:var(--text);
    background:transparent;
  }
  .btn-ghost:hover{border-color:var(--teal); color:var(--teal);}

  .hero-contact{
    display:flex; flex-wrap:wrap; gap:18px;
    font-family:var(--font-mono);
    font-size:0.82rem;
    color:var(--text-faint);
  }
  .hero-contact a{text-decoration:none; color:var(--text-faint); border-bottom:1px solid transparent;}
  .hero-contact a:hover{color:var(--teal); border-color:var(--teal);}

  /* photo */
  .photo-frame{
    position:relative;
    width:100%;
    aspect-ratio:1/1;
    max-width:320px;
    margin-left:auto;
    border-radius:12px;
    border:1px dashed var(--border);
    background:
      linear-gradient(135deg, var(--surface) 0%, var(--surface-alt) 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center;
    padding:24px;
  }
  .photo-frame .avatar-initials{
    width:88px; height:88px; border-radius:50%;
    background:var(--surface-alt);
    border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-display);
    font-size:1.6rem; font-weight:600;
    color:var(--amber);
    margin-bottom:16px;
  }
  .photo-frame p{
    font-family:var(--font-mono);
    font-size:0.72rem;
    color:var(--text-faint);
    margin:0;
    line-height:1.5;
  }
  .photo-frame code{
    color:var(--teal);
    background:rgba(63,182,168,0.08);
    padding:1px 5px;
    border-radius:3px;
  }
  /* To use a real photo: replace the .avatar-initials block in the HTML with
     <img src="assets/profile.jpg" alt="Amos Maina Muthee" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"> */

  /* connector flow diagram */
  .flow-diagram{margin-top:40px;}
  .flow-svg{width:100%; height:auto; display:block;}
  .flow-dot{
    animation:travel 7s linear infinite;
    offset-rotate:0deg;
  }
  @keyframes travel{
    0%{ offset-distance:0%; opacity:0;}
    5%{opacity:1;}
    95%{opacity:1;}
    100%{ offset-distance:100%; opacity:0;}
  }

  @media (max-width:860px){
    .hero-grid{grid-template-columns:1fr; gap:40px;}
    .photo-frame{margin-left:0; max-width:220px;}
  }

  /* ---------- SECTION SHELL ---------- */
  section{
    padding:64px 0;
    border-bottom:1px solid var(--border);
  }
  section:last-of-type{border-bottom:none;}
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    gap:20px;
    margin-bottom:32px;
    flex-wrap:wrap;
  }
  .section-head h2{
    font-family:var(--font-display);
    font-size:1.55rem;
    font-weight:600;
    margin:0;
  }
  .section-num{
    font-family:var(--font-mono);
    font-size:0.8rem;
    color:var(--text-faint);
  }
  .section-lede{
    color:var(--text-muted);
    max-width:66ch;
    margin:0 0 32px;
  }

  /* ---------- ABOUT ---------- */
  .about-body p{color:var(--text-muted); max-width:74ch; margin:0 0 16px;}
  .about-body p:last-child{margin-bottom:0;}

  /* ---------- CHIPS / SKILLS ---------- */
  .chip-row{display:flex; flex-wrap:wrap; gap:10px;}
  .chip{
    font-family:var(--font-mono);
    font-size:0.8rem;
    color:var(--text-muted);
    border:1px solid var(--border);
    padding:6px 12px;
    border-radius:999px;
    background:var(--surface);
  }

  .skill-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
    gap:18px;
  }
  .skill-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:20px;
  }
  .skill-card h3{
    font-family:var(--font-display);
    font-size:0.98rem;
    margin:0 0 12px;
    color:var(--amber);
    font-weight:600;
  }
  .skill-card p{
    margin:0;
    color:var(--text-muted);
    font-size:0.88rem;
    line-height:1.65;
  }

  /* ---------- PIPELINE ---------- */
  .pipeline{
    display:flex;
    flex-wrap:wrap;
    align-items:stretch;
    gap:0;
    border:1px solid var(--border);
    border-radius:var(--radius);
    overflow:hidden;
    background:var(--surface);
  }
  .pipeline-step{
    flex:1 1 130px;
    padding:20px 16px;
    display:flex; flex-direction:column; gap:8px;
    border-right:1px solid var(--border);
    position:relative;
  }
  .pipeline-step:last-child{border-right:none;}
  .pipeline-step .n{
    font-family:var(--font-mono);
    font-size:0.72rem;
    color:var(--teal);
  }
  .pipeline-step .label{
    font-family:var(--font-display);
    font-size:0.9rem;
    font-weight:600;
  }
  @media (max-width:700px){
    .pipeline{flex-direction:column;}
    .pipeline-step{border-right:none; border-bottom:1px solid var(--border);}
    .pipeline-step:last-child{border-bottom:none;}
  }

  .capability-list{
    columns:2;
    column-gap:32px;
    color:var(--text-muted);
    font-size:0.92rem;
    padding-left:18px;
    margin:0;
  }
  .capability-list li{margin-bottom:9px; break-inside:avoid;}
  @media (max-width:700px){.capability-list{columns:1;}}

  /* ---------- EXPERIENCE ---------- */
  .exp-block{
    display:grid;
    grid-template-columns:220px 1fr;
    gap:32px;
  }
  .exp-meta h3{
    font-family:var(--font-display);
    font-size:1.05rem;
    margin:0 0 4px;
  }
  .exp-meta .org{color:var(--amber); font-size:0.92rem; margin-bottom:6px;}
  .exp-meta .dates{
    font-family:var(--font-mono);
    font-size:0.78rem;
    color:var(--text-faint);
  }
  .exp-list{margin:0; padding-left:18px; color:var(--text-muted); font-size:0.93rem;}
  .exp-list li{margin-bottom:10px;}
  @media (max-width:700px){
    .exp-block{grid-template-columns:1fr; gap:14px;}
  }

  /* ---------- PROJECTS ---------- */
  .project-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));
    gap:20px;
  }
  .project-card{
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:22px;
    background:var(--surface);
    display:flex; flex-direction:column; gap:10px;
    transition:border-color 0.15s ease;
  }
  .project-card:hover{border-color:var(--teal-dim);}
  .project-card h3{
    font-family:var(--font-display);
    font-size:1.02rem;
    margin:0;
    font-weight:600;
  }
  .project-role{
    font-family:var(--font-mono);
    font-size:0.74rem;
    color:var(--teal);
  }
  .project-card p{
    color:var(--text-muted);
    font-size:0.88rem;
    margin:0;
    flex-grow:1;
  }
  .project-link{
    font-size:0.84rem;
    color:var(--amber);
    text-decoration:none;
    border-bottom:1px solid transparent;
  }
  .project-link:hover{border-color:var(--amber);}

  /* ---------- STRENGTHS ---------- */
  .strength-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
    gap:18px;
  }
  .strength-card h3{
    font-size:0.95rem;
    font-family:var(--font-display);
    margin:0 0 8px;
    font-weight:600;
    color:var(--text);
  }
  .strength-card p{
    color:var(--text-muted);
    font-size:0.86rem;
    margin:0;
  }

  /* ---------- EDUCATION ---------- */
  .edu-card{
    border:1px solid var(--border);
    border-radius:var(--radius);
    background:var(--surface);
    padding:26px;
    display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap;
  }
  .edu-card h3{font-family:var(--font-display); margin:0 0 4px; font-size:1.05rem;}
  .edu-card .school{color:var(--amber); font-size:0.92rem;}
  .edu-card .year{font-family:var(--font-mono); color:var(--text-faint); font-size:0.85rem;}
  .edu-areas{margin:14px 0 0; padding-left:18px; color:var(--text-muted); font-size:0.88rem; columns:2;}
  @media (max-width:600px){.edu-areas{columns:1;}}

  /* ---------- CONTACT / FOOTER ---------- */
  .contact-panel{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:40px;
    display:flex; justify-content:space-between; align-items:center; gap:32px;
    flex-wrap:wrap;
  }
  .contact-panel h2{
    font-family:var(--font-display);
    font-size:1.5rem;
    margin:0 0 8px;
  }
  .contact-panel p{color:var(--text-muted); margin:0; max-width:42ch;}
  .contact-links{display:flex; flex-direction:column; gap:10px; font-family:var(--font-mono); font-size:0.86rem;}
  .contact-links a{text-decoration:none; color:var(--teal);}
  .contact-links a:hover{color:var(--amber);}

  footer{
    padding:28px 0 40px;
    text-align:center;
    color:var(--text-faint);
    font-size:0.8rem;
  }
</style>
</head>
