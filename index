  <!-- AUTOMATION -->
  <section id="automation">
    <div class="wrap">
      <div class="section-head">
        <h2>Business automation &amp; CRM</h2>
        <span class="section-num">03</span>
      </div>
      <p class="section-lede">
        I turn repetitive business activity into workflows that run themselves — connecting websites,
